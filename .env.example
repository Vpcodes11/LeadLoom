# Postgres. Local: postgresql://postgres:postgres@localhost:5432/leadloom
# Neon/Supabase: DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadloom"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/leadloom"

# Session signing secret: run `openssl rand -hex 32`
AUTH_SECRET=""

# Claude API. Leave empty to run in demo mode with placeholder AI output.
ANTHROPIC_API_KEY=""

# Public base URL (Stripe redirects, client review links)
APP_URL="http://localhost:3000"

# Protects /api/jobs/run (called by Vercel Cron to retry stuck jobs). Run `openssl rand -hex 32`
CRON_SECRET=""

# Stripe (optional; checkout is disabled without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""
