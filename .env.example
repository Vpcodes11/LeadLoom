# Postgres (Neon). `neon deploy` / `neon env pull` writes these.
# DATABASE_URL = pooled (-pooler) for the app; DATABASE_URL_UNPOOLED = direct, used by Prisma Migrate.
# Local Postgres works too: set both to postgresql://postgres:postgres@localhost:5432/leadloom
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Session signing secret: run `openssl rand -hex 32`
AUTH_SECRET=""

# Claude API. Leave empty to run in demo mode with placeholder AI output.
ANTHROPIC_API_KEY=""

# Public base URL (checkout redirects, client review links)
APP_URL="http://localhost:3000"

# Protects /api/jobs/run (called by Vercel Cron to retry stuck jobs). Run `openssl rand -hex 32`
CRON_SECRET=""

# Dodo Payments billing (optional; checkout is disabled without an API key).
# Developer > API Keys: create a key in the same mode as DODO_PAYMENTS_ENVIRONMENT.
# Developer > Webhooks: endpoint {APP_URL}/api/billing/webhook with all subscription.* events; copy its signing secret.
# Products: one monthly subscription product per plan; paste the pdt_... IDs.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# "test_mode" (test.dodopayments.com) or "live_mode" (live.dodopayments.com)
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PRODUCT_STARTER=""
DODO_PRODUCT_GROWTH=""
DODO_PRODUCT_AGENCY=""

# Transactional email via Resend (password resets, invites, client-feedback alerts).
# Without it, the app still works: invites show a copyable link, emails are logged.
RESEND_API_KEY=""
EMAIL_FROM="Leadloom <noreply@yourdomain.com>"

# Shown on the Terms and Privacy pages as the contact address.
SUPPORT_EMAIL=""

# "Continue with Google" (optional; the button is hidden until both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
