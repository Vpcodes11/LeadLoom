# Database (SQLite for local dev; switch provider to "postgresql" in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Session signing secret (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Claude API. Leave empty to run in demo mode with placeholder AI output.
ANTHROPIC_API_KEY=""

# Public base URL (used for Stripe redirects and client review links)
APP_URL="http://localhost:3000"

# Stripe (optional; billing page shows plans but checkout is disabled without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""
